# APP_SECRET must be at least 32 characters (used to encrypt Todoist tokens)
APP_SECRET=change-me-to-a-long-random-string
PORT=8787
DB_PATH=./data/session.db

# Session evaluation (LLM). Without ANTHROPIC_API_KEY the worker is disabled and evaluations stay pending.
# Never commit a real key.
# ANTHROPIC_API_KEY=
# EVAL_MODEL=claude-haiku-5-5
# EVAL_PROMPT_VERSION=v1
