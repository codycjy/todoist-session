# APP_SECRET must be at least 32 characters (used to encrypt Todoist tokens)
APP_SECRET=change-me-to-a-long-random-string
PORT=8787
DB_PATH=./data/session.db

# Session evaluation (LLM) via OpenRouter (OpenAI-compatible chat completions).
# OPENAI_API_KEY holds the OpenRouter key. Without it the worker is disabled and evaluations stay pending.
# Never commit a real key.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# EVAL_MODEL=deepseek/deepseek-v4.1-flash-1017
# EVAL_PROMPT_VERSION=v1
